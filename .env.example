# Desenvolvimento local: banco de demonstração SQLite, separado do Supabase.
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_PATH=./data/familia.sqlite
NODE_ENV=development

# Vercel usa o novo Sites demo configurado em shared/supabase.json.
# Não precisa de BACKEND_URL, Blob ou chave secreta na Vercel.
# Nunca publique credenciais privadas do Supabase nem as use com prefixo VITE_.
