# Desenvolvimento local (SQLite no computador, sem conexão externa):
APP_ORIGIN=http://localhost:5173
PORT=3001
DATABASE_PATH=./data/familia.sqlite
NODE_ENV=development

# Vercel: conecte um Blob PRIVADO ao projeto pela aba Storage e faça Redeploy.
# A Vercel adiciona BLOB_READ_WRITE_TOKEN automaticamente. Não copie o token para o GitHub.
# Não é necessário configurar BACKEND_URL nem APP_ORIGIN na Vercel.
