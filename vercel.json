{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/sorteio",
      "destination": "/index.html"
    },
    {
      "source": "/meu-resultado",
      "destination": "/index.html"
    },
    {
      "source": "/adm",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 30
    }
  }
}
